<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MobileSpeaker</RootNamespace>
    <AssemblyName>MobileSpeaker</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <Version>1.1.0</Version>
    <Product>MobileSpeaker</Product>
    <Description>Usa el celular como parlante de la PC por Wi-Fi.</Description>

    <!-- Windows x64 autocontenido: no requiere instalar .NET -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- La carpeta publish (salida del instalador) no forma parte del proyecto -->
    <DefaultItemExcludes>$(DefaultItemExcludes);publish\**;installer\**</DefaultItemExcludes>

    <!--
      Por defecto `dotnet publish -c Release` genera un solo .exe portable.
      El script del instalador publica sin PublishSingleFile (carpeta normal, arranque mas rapido).
    -->
    <PublishSingleFile Condition="'$(PublishSingleFile)' == ''">true</PublishSingleFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- La pagina del celular y el icono van embebidos dentro del exe -->
    <None Remove="Web\**" />
    <Content Remove="Web\**" />
    <EmbeddedResource Include="Web\index.html" LogicalName="MobileSpeaker.Web.index.html" />
    <EmbeddedResource Include="Assets\app.ico" LogicalName="MobileSpeaker.app.ico" />
  </ItemGroup>

</Project>
